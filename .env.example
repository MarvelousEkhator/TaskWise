# Port for local development (Render sets its own PORT in production)
PORT=3000

# Postgres connection strings (Neon). DATABASE_URL is the pooled one, DIRECT_URL is the direct one.
DATABASE_URL=postgresql://user:password@host-pooler/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@host/neondb?sslmode=require

# The exact public address of your site, no trailing slash. Google sign-in needs it.
ALLOWED_ORIGIN=https://your-app.onrender.com

# Google sign-in (create an OAuth client in Google Cloud)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Long random value used to protect login sessions
SESSION_SECRET=replace-with-a-long-random-value

# The one Google account allowed to see LaunchGuard (developer mode)
ADMIN_EMAIL=you@example.com

# Optional owner key so an AI agent can open the admin's own tasks: Authorization: Bearer <key>
TASKWISE_API_KEY=replace-with-a-long-random-value